      "values" : {}
    } ],
    "documentation" : " Maximum number of runtime request results whose SDK completion logic and synchronous customer future\n continuations may run concurrently per client. Large result batches are submitted incrementally and share\n this bound with individual responses. The existing worker policy uses virtual threads on Java 25 and newer\n and a lazily populated fixed platform-thread pool on Java 21 through 24. Defaults to\n {@code fluxzero.runtime.ingress.maxCompletionConcurrency}, or {@code 8} when unset.\n",
    "constantValue" : null
  }, {
    "name" : "maxConcurrentRuntimeWebSocketMessages",
    "qualifiedName" : "io.fluxzero.sdk.configuration.client.WebSocketClient$ClientConfig.maxConcurrentRuntimeWebSocketMessages",
    "type" : "int",
    "modifiers" : [ ],
    "annotations" : [ {
      "annotationType" : "lombok.Builder.Default",
      "values" : {}
    } ],
    "documentation" : " Maximum number of complete SDK runtime messages decoded or waiting for bounded result-dispatcher admission\n concurrently per WebSocket session.\n Defaults to {@code fluxzero.runtime.ingress.maxConcurrency}, its legacy WebSocket aliases, or {@code 3}\n when unset. This limit does not serialize result completions; configure\n {@link #maxConcurrentRuntimeResultCompletions} separately for that.\n",
    "constantValue" : null
  }, {
