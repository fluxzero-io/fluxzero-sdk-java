---
export type Tone = 'entity' | 'command' | 'neutral' | 'success' | 'warning';
export type Box = { x: number; y: number; w: number; h: number; lines: string[]; tone: Tone };
export type Label = { x: number; y: number; text: string; bold?: boolean; start?: boolean };
export type Edge = { d: string; parent?: boolean };
export type Panel = { x: number; y: number; w: number; h: number; title: string; tone: Tone };
export type Diagram = { title: string; caption: string; height: number; boxes: Box[]; labels?: Label[]; edges?: Edge[]; panels?: Panel[] };
interface Props { diagram: Diagram; id: string }
const { diagram, id } = Astro.props;
---

<figure class="model-figure">
  <div class="drawing" tabindex="0" role="region" aria-label={diagram.title}>
    <svg viewBox={`0 0 640 ${diagram.height}`} role="img" aria-labelledby={`${id}-title`}>
      <title id={`${id}-title`}>{diagram.title}</title>
      <defs>
        <marker id={`${id}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" class="arrowhead" />
        </marker>
      </defs>
      {diagram.panels?.map(p => <g class={`panel ${p.tone}`}>
        <rect x={p.x} y={p.y} width={p.w} height={p.h} rx="6" />
        <text x={p.x + p.w / 2} y={p.y + 23} class="panel-title">{p.title}</text>
      </g>)}
      {diagram.edges?.map(e => <path d={e.d} class:list={['edge', { parent: e.parent }]} marker-end={`url(#${id}-arrow)`} />)}
      {diagram.boxes.map(b => <g class={`node ${b.tone}`}>
        <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
        <text x={b.x + b.w / 2} y={b.y + b.h / 2 - (b.lines.length - 1) * 11}>
          {b.lines.map((line, i) => <tspan x={b.x + b.w / 2} dy={i ? 22 : 0}>{line}</tspan>)}
        </text>
      </g>)}
      {diagram.labels?.map(l => <text x={l.x} y={l.y} class:list={['label', { bold: l.bold, start: l.start }]}>{l.text}</text>)}
    </svg>
  </div>
  <figcaption>{diagram.caption}</figcaption>
</figure>

<style>
  .model-figure { margin: 1.75rem 0; }
  .drawing { overflow-x: auto; background: rgba(0, 0, 0, .02); border-radius: 8px; padding: 16px; }
  .drawing:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
  svg { display: block; width: 100%; min-width: 520px; max-width: 720px; margin: 0 auto; font-family: var(--sl-font); font-size: 16px; }
  text { text-anchor: middle; dominant-baseline: middle; fill: var(--sl-color-text); }
  rect { stroke-width: 1; }
  .entity { --fill: #ede9fe; --stroke: #8b5cf6; --ink: #3b276b; }
  .command { --fill: #dbeafe; --stroke: #3b82f6; --ink: #1e3a8a; }
  .neutral { --fill: #f8fafc; --stroke: #94a3b8; --ink: #334155; }
  .success { --fill: #dcfce7; --stroke: #16a34a; --ink: #14532d; }
  .warning { --fill: #fff7ed; --stroke: #ea580c; --ink: #9a3412; }
  .node rect, .panel rect { fill: var(--fill); stroke: var(--stroke); }
  .node text, .panel text { fill: var(--ink); }
  .panel-title, .bold { font-weight: 600; }
  .edge { fill: none; stroke: #64748b; stroke-width: 1.5; }
  .parent { stroke-dasharray: 3 5; }
  .arrowhead { fill: #64748b; }
  .start { text-anchor: start; }
  .label, .panel-title { font-size: 15px; }
  figcaption { margin-top: .75rem; font-size: .9rem; line-height: 1.6; color: var(--sl-color-gray-2); }
  :global([data-theme='dark']) .drawing { background: rgba(255, 255, 255, .035); }
  :global([data-theme='dark']) .edge { stroke: #94a3b8; }
  :global([data-theme='dark']) .arrowhead { fill: #94a3b8; }
</style>

