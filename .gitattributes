# Normalize text files to LF by default.
* text=auto eol=lf

# Keep Windows command scripts on CRLF for native execution.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts should always use LF.
*.sh text eol=lf

# Unified patch context includes significant single-space lines.
docs/agents-history/patches/*.patch -whitespace
